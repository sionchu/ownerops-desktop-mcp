{
  "proxy": {
    "serverInfo": {
      "name": "OwnerOps Desktop",
      "version": "0.5.0",
      "instructions": "Unified Windows control plus constrained public-web read/crawl and browser automation."
    },
    "routing": {
      "mode": "unified",
      "basePath": "/mcp"
    },
    "authentication": {
      "enabled": false
    },
    "logging": {
      "logRequests": true,
      "logResponses": false,
      "sensitiveDataMask": true
    },
    "caching": {
      "tools": {
        "enabled": true,
        "ttlSeconds": 60
      }
    }
  },
  "mcp": {
    "desktop": {
      "type": "stdio",
      "title": "Desktop Commander",
      "description": "Official Desktop Commander MCP engine",
      "command": "C:\\Program Files\\nodejs\\node.exe",
      "arguments": [
        "C:\\Users\\getch\\mcp\\ownerops-desktop-mcp\\node_modules\\@wonderwhy-er\\desktop-commander\\dist\\index.js"
      ],
      "environment": {
        "USERPROFILE": "C:\\Users\\getch\\mcp\\ownerops-desktop-mcp\\runtime\\home",
        "HOME": "C:\\Users\\getch\\mcp\\ownerops-desktop-mcp\\runtime\\home",
        "DESKTOP_COMMANDER_DISABLE_TELEMETRY": "1",
        "PATH": "C:\\Windows\\System32\\WindowsPowerShell\\v1.0;C:\\Windows\\System32;C:\\Program Files\\Git\\cmd;C:\\Program Files\\nodejs;C:\\Users\\getch\\AppData\\Local\\Programs\\Python\\Python312;C:\\Users\\getch\\AppData\\Local\\Programs\\Python\\Python312\\Scripts;C:\\Program Files\\Tesseract-OCR"
