          "patterns": [
            "audio",
            "cert_store",
            "defender_status",
            "disk_inspect",
            "driver_list",
            "env",
            "event_log",
            "file_streams",
            "firewall",
            "fs_changes",
            "integrity",
            "network",
            "notification",
            "process_inspect",
            "registry_get",
            "registry_set",
            "reliability",
            "scheduled_task",
            "security_audit",
            "service",
            "startup_report",
            "storage_health",
            "system_info",
            "verify_signature",
            "watch"
