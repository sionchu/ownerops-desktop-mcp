        "WIN32_MCP_SECURITY_PROFILE": "interactive",
        "WIN32_MCP_RESULT_ENVELOPE": "1",
        "TESSERACT_CMD": "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
        "PATH": "C:\\Program Files\\Tesseract-OCR;C:\\Windows\\System32\\WindowsPowerShell\\v1.0;C:\\Windows\\System32;C:\\Program Files\\Git\\cmd;C:\\Program Files\\nodejs;C:\\Users\\getch\\AppData\\Local\\Programs\\Python\\Python312;C:\\Users\\getch\\AppData\\Local\\Programs\\Python\\Python312\\Scripts"
      },
      "enabled": true,
      "tools": {
        "prefix": "win",
        "prefixSeparator": "_"
