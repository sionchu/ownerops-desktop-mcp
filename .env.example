DESKTOP_MCP_HOST=127.0.0.1
DESKTOP_MCP_PORT=8765
DESKTOP_MCP_PUBLIC_BASE=https://your-host.example.com/ownerops
DESKTOP_MCP_PUBLIC_URL=https://your-host.example.com/ownerops/mcp
DESKTOP_MCP_ROOTS=C:\Users\you\Projects
DESKTOP_MCP_DENY_NAMES=.ssh;.gnupg;.aws;.azure
DESKTOP_MCP_MAX_READ_BYTES=1048576
DESKTOP_MCP_MAX_WRITE_BYTES=1048576
DESKTOP_MCP_SHELL_ENABLED=true
DESKTOP_MCP_SHELL=cmd
DESKTOP_MCP_SHELL_TIMEOUT=60
DESKTOP_MCP_SHELL_MAX_OUTPUT=200000
DESKTOP_MCP_SHELL_ALLOW=git;python;uv;node;npm;npx;pytest;ruff;where;dir;type;echo;findstr;tasklist
DESKTOP_MCP_AUTH_MODE=oauth
DESKTOP_MCP_TOKEN=replace-with-a-long-random-token
DESKTOP_MCP_OAUTH_USERNAME=owner
DESKTOP_MCP_OAUTH_PASSWORD=replace-with-a-long-random-password
